# ----- Django (backend) -----
# Copy to .env or export in your shell. Without DATABASE_URL, SQLite is used.
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL connection URL (optional). Falls back to SQLite when unset.
DATABASE_URL=postgres://tripgo:tripgo@localhost:5432/tripgo

# Seat hold window (minutes) used by the booking engine (defaults to 15).
SEAT_HOLD_MINUTES=15

# ----- Flutter (frontend) -----
# Android emulator reaches the host machine via 10.0.2.2 (default).
# For a physical device, set to your machine's LAN IP.
# Build with: flutter build apk --dart-define=API_BASE_URL=http://192.168.1.5:8000/api/
# API_BASE_URL=http://10.0.2.2:8000/api/